	"遅延セグ木（基本形）":{
		"prefix":"lsegset",
		"body":[
			"#include<atcoder/lazysegtree>",
			"using namespace atcoder;",
			"",
			"/* S_type: モノイドの型 */",
			"using S_type = ${1:ll};",
			"/* F_type: 作用素の型 */",
			"using F_type = ${2:ll};",
			"/* op: モノイドの演算 */",
			"S_type op(S_type a, S_type b) { return max(a, b); }",
			"/* e: opの単位元 */",
			"S_type e() { return 0; }",
			"/* mapping: fをxに作用させる */",
			"S_type mapping(F_type f, S_type x) { return x + f; }",
			"/* composition: f(g(x))に対応する作用素 */",
			"F_type composition(F_type f, F_type g) { return f + g; }",
			"/* id: mappingの恒等写像 */",
			"F_type id() { return 0; }",
			"",
			"lazy_segtree<",
			"\tS_type, op, e, F_type, mapping, composition, id",
			"> lseg(${0:N});"
		]
	},

	"遅延セグ木（区間affine更新・区間和）":{
		"prefix":[
			"lseg_sum",
			"lseg_add_sum",
			"lseg_mul_sum",
			"lseg_assign_sum"
		],
		"body":[
			"#include<atcoder/lazysegtree>",
			"using namespace atcoder;",
			"",
			"using LS_V = ${1:ll}; // ll, mint など",
			"struct LS_S { LS_V sum; ll len; };",
			"/* x -> a*x+b．加算:{1,b}, 乗算:{a,0}, 更新:{0,b} */",
			"struct LS_F { LS_V a, b; };",
			"LS_S LS_op(LS_S x, LS_S y) { return {x.sum+y.sum, x.len+y.len}; }",
			"LS_S LS_e() { return {LS_V(0), 0}; }",
			"LS_S LS_mapping(LS_F f, LS_S x) { return {f.a*x.sum+f.b*LS_V(x.len), x.len}; }",
			"/* f(g(x)) */",
			"LS_F LS_composition(LS_F f, LS_F g) { return {f.a*g.a, f.a*g.b+f.b}; }",
			"LS_F LS_id() { return {LS_V(1), LS_V(0)}; }",
			"",
			"vector<LS_S> LS_init(${2:N});",
			"rep(i, ${2:N}) LS_init[i] = {${3:A[i]}, 1};",
			"lazy_segtree<",
			"\tLS_S, LS_op, LS_e,",
			"\tLS_F, LS_mapping, LS_composition, LS_id",
			"> lseg(LS_init);",
		]
	},

	"遅延セグ木（区間affine更新・区間max/min）":{
		"prefix":[
			"lseg_max",
			"lseg_min",
			"lseg_add_max",
			"lseg_add_min",
			"lseg_mul_max",
			"lseg_mul_min",
			"lseg_assign_max",
			"lseg_assign_min"
		],
		"body":[
			"#include<atcoder/lazysegtree>",
			"using namespace atcoder;",
			"",
			"using LM_V = ${1:ll}; // 順序比較・乗算が可能な型",
			"struct LM_S { LM_V mx, mn; bool empty; };",
			"/* x -> a*x+b．加算:{1,b}, 乗算:{a,0}, 更新:{0,b} */",
			"struct LM_F { LM_V a, b; };",
			"LM_S LM_op(LM_S x, LM_S y) {",
			"\tif(x.empty) return y;",
			"\tif(y.empty) return x;",
			"\treturn {max(x.mx,y.mx), min(x.mn,y.mn), false};",
			"}",
			"LM_S LM_e() { return {LM_V(), LM_V(), true}; }",
			"LM_S LM_mapping(LM_F f, LM_S x) {",
			"\tif(x.empty) return x;",
			"\tLM_V p=f.a*x.mx+f.b, q=f.a*x.mn+f.b;",
			"\treturn {max(p,q), min(p,q), false};",
			"}",
			"/* f(g(x)) */",
			"LM_F LM_composition(LM_F f, LM_F g) { return {f.a*g.a, f.a*g.b+f.b}; }",
			"LM_F LM_id() { return {LM_V(1), LM_V(0)}; }",
			"",
			"vector<LM_S> LM_init(${2:N});",
			"rep(i, ${2:N}) LM_init[i] = {${3:A[i]}, ${3:A[i]}, false};",
			"lazy_segtree<",
			"\tLM_S, LM_op, LM_e,",
			"\tLM_F, LM_mapping, LM_composition, LM_id",
			"> lseg(LM_init);",
			"/* lseg.prod(l,r).mx / .mn で取得 */",
		]
	},

