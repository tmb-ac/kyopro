			"\tll ret=1;",
			"\tfor(ll i=1;i<=r;i++){",
			"\t\tret*=n;",
			"\t\tret/=i;",
			"\t\tn--;",
			"\t}",
			"\treturn ret;",
			"}",
			"",
			"// 01列について，辞書順で何番目か(0-indexed)を返す関数",
			"ll order(vector<bool> V, ll N) {",
			"\tll zero = 0, one = 0;",
			"\tfor(auto e : V) e ? one++ : zero++;",
			"\tll ret = 0;",
			"\tfor(auto e : V) {",
			"\t\tif(e) {",
			"\t\t\tret += nCr(zero - 1 + one, one);",
			"\t\t\tone--;",
			"\t\t}else zero--;",
			"\t}",
			"\treturn ret;",
			"}",
		],
