			"vector<ll> seek_prime(ll N) {",
			"\tll i, j;",
			"\tvector<bool> not_prime(N + 1, 0);",
			"\tvector<ll> prime;",
			"\tfor(i = 2; i <= N; i++) {",
			"\t\tif(not_prime[i]) continue;",
			"\t\tprime.push_back(i);",
			"\t\tif(i <= N / i) for(j = i * i; j <= N; j += i) not_prime[j] = 1;",
			"\t}",
			"\treturn prime;",
			"}",
