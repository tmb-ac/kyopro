		"body": [
			"// 偏角ソート用クラス",
			"class dir {",
			"public:",
			"\tint get_rg() const {",
			"\t\tif (x >  0 && y == 0) return 0; // x軸正方向",
			"\t\tif (x >  0 && y >= 0) return 1; // 第1象限",
			"\t\tif (x == 0 && y >  0) return 2; // y軸正方向",
			"\t\tif (x <= 0 && y >  0) return 3; // 第2象限",
			"\t\tif (x <  0 && y == 0) return 4; // x軸負方向",
			"\t\tif (x <  0 && y <= 0) return 5; // 第3象限",
			"\t\tif (x == 0 && y <  0) return 6; // y軸負方向",
			"\t\tif (x >= 0 && y <  0) return 7; // 第4象限",
			"\t\treturn -1; // 原点",
			"\t}",
			"\tbool operator<(const dir& b) const {",
			"\t\tint rg_a = get_rg();",
			"\t\tint rg_b = b.get_rg();",
			"\t\tif (rg_a != rg_b) return rg_a < rg_b;",
			"\t\t// 同じ領域なら外積で比較",
			"\t\treturn y * b.x < x * b.y;",
			"\t}",
			"\tll hoge; // 好きな情報を載せる",
			"\tll x, y;",
			"\tll rank; // 小さい順で何種類目の偏角か (0-indexed)",
			"};",
			"",
			"void sort_dirs(vector<dir>& dirs) {",
			"\tsort(dirs.begin(), dirs.end());",
			"\tll rank = 0;",
			"\trep(i, dirs.size()) {",
			"\t\tif(0 < i && dirs[i-1] < dirs[i]) rank++;",
			"\t\tdirs[i].rank = rank;",
			"\t}",
			"}",
			"",
			"\tvector<dir> dirs;",
			"\tsort_dirs(dirs);",
		],
	},

	"ポテンシャル付きunion-find": {
		"prefix": [
			"dsu-potential",
			"omomituki-union-find",
		],
		"body": [
			"#include<bits/stdc++.h>",
			"using namespace std;",
			"#define ll long long",
			"#define rep(i, N) for(ll i = 0; i < N; i++)",
			"",
			"/*重みに使用する型(ll or mint)*/",
			"using type = ll;",
			"",
			"class dsup{",
			"private:",
			"\tll N;",
			"\tvector<ll>P;/*親ノード*/",
			"\tvector<ll>S;/*連結成分のサイズ*/",
			"\tvector<type>W;/*重み*/",
			"\tpair<ll,type> root(ll now){",
			"\t\tif(now!=P[now]){",
			"\t\t\tpair<ll,type>ret=root(P[now]);",
			"\t\t\tP[now]=ret.first;",
			"\t\t\tW[now]+=ret.second;",
			"\t\t}",
			"\t\treturn {P[now],W[now]};",
			"\t}",
			"public:",
			"\tdsup(ll n){",
			"\t\tN=n;",
			"\t\tP=vector<ll>(N+1);",
			"\t\tfor(ll i=0;i<=N;i++)P[i]=i;",
			"\t\tS=vector<ll>(N+1,1);",
			"\t\tW=vector<type>(N+1,0);",
			"\t}",
			"\t/*a+w=bとして連結する*/",
			"\tbool merge(ll a,ll b,type w){",
			"\t\troot(a);root(b);",
			"\t\tw+=W[a]-W[b];",
			"\t\ta=P[a];b=P[b];",
			"\t\tif(a==b)return w==0;",
			"\t\tif(S[a]<S[b]){",
			"\t\t\tP[a]=b;",
			"\t\t\tS[b]+=S[a];",
			"\t\t\tW[a]=-w;",
			"\t\t}else{",
			"\t\t\tP[b]=a;",
			"\t\t\tS[a]+=S[b];",
			"\t\t\tW[b]=w;",
			"\t\t}",
			"\t\treturn 1;",
			"\t}",
			"\t/*a,bの連結判定*/",
			"\tbool same(ll a,ll b){",
			"\t\ta=root(a).first;b=root(b).first;",
			"\t\treturn a==b; ",
			"\t}",
			"\t/*a連結成分のsizeを返す*/",
			"\tll size(ll a){return S[root(a).first];}",
			"\t/*全ての連結成分を列挙(1-indexed)*/",
			"\tvector<vector<ll>> groups(void){",
			"\t\tmap<ll,vector<ll>>m;",
			"\t\tvector<vector<ll>>ret;",
			"\t\tfor(ll i=1;i<=N;i++)m[root(i).first].push_back(i);",
			"\t\tfor(auto e:m)ret.push_back(e.second);",
			"\t\treturn ret;",
			"\t}",
			"\t/*idのpotentialを求める*/",
			"\ttype get_p(ll id){return root(id).second;}",
			"};",
			"\tdsup d(N);",
			"\td.merge(a,b,w);",
			"\td.get_p(a);",
			"\td.same(a,b);",
		],
	},

