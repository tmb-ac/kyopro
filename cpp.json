	"行列の積を求めるテンプレート": {
		"prefix": [
			"matrix",
			"gyoretu"
		],
		"body": [
			"using S_type = ${1:mint};",
			"#define v(S_type) vector<S_type>",
			"#define vv(S_type) vector<v(S_type)>",
			"/* N次正方行列の積 M=A×X^Kを求める */",
			"vv(S_type) matrix(vv(S_type) A,vv(S_type) X,ll N,ll K){",
			"\tll i,j,k;",
			"\tvv(S_type)M_now=A;",
			"\tvv(S_type)M_next(N,v(S_type)(N));",
			"\tvv(S_type)X_now=X;",
			"\tvv(S_type)X_next(N,v(S_type)(N));",
			"\tfor(;K!=0;K/=2){",
			"\t\tif(K%2){",
			"\t\t\trep(i,N)rep(j,N){",
			"\t\t\t\tM_next[i][j]=0;",
			"\t\t\t\trep(k,N)M_next[i][j]+=M_now[i][k]*X_now[k][j];",
			"\t\t\t}",
			"\t\t\tswap(M_now,M_next);",
			"\t\t}",
			"\t\trep(i,N)rep(j,N){",
			"\t\t\tX_next[i][j]=0;",
			"\t\t\trep(k,N)X_next[i][j]+=X_now[i][k]*X_now[k][j];",
			"\t\t}",
			"\t\tswap(X_now,X_next);",
			"\t}",
			"\treturn M_now;",
			"}",
			"$0",
			"\tll N,K;",
			"",
			"\tvv(S_type) A(N,v(S_type)(N,0));",
			"\tvv(S_type) E(N,v(S_type)(N,0));",
			"\trep(i,E.size())E[i][i]=1;",
			"",
			"\t/* B=E×A^K  E,A:N×N正方行列 */",
			"\tvector<vector<S_type>>B=matrix(E,A,N,K);"
		],
	},

