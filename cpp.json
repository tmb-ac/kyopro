	"ダブリング": {
		"prefix": [
			"doubling",
			"daburingu"
		],
		"body": [
			"ll N;",
			"ll X[200009];",
			"ll db[62][200009];",
			"bool doubled = 0;",
			"/* i:=X[i]となる遷移をダブリングする */",
			"void doubling_set(void) {",
			"\tll i, j;",
			"\tdoubled = 1;",
			"\trep(j, N)db[0][j] = X[j];",
			"\tfor(i = 1; i < 62; i++)rep(j, N)",
			"\t\tdb[i][j] = db[i - 1][db[i - 1][j]];",
			"}",
			"",
			"ll state[200009];",
			"/* state[]からK回遷移する */",
			"void doubling(ll K) {",
			"\tll i, k;",
			"\tif(!doubled) doubling_set();",
			"\tfor(k = 0; K != 0; k++, K /= 2) {",
			"\t\tif(K % 2)rep(i, N)state[i] = db[k][state[i]];",
			"\t}",
			"}",
		],
	},

	"マージソート木": {
		"prefix": "merge_sort_tree",
		"body": [
			"class merge_sort_tree{",
			"private:",
			"\tll size;",
			"\tll tall;",
			"\tvector<vector<ll>> tree;",
			"\tvector<vector<__int128_t>> sum;",
			"public:",
			"\tmerge_sort_tree(vector<ll> A){",
			"\t\tll s=A.size();",
			"\t\tfor(tall=0;(1LL<<tall)<s;tall++);",
			"\t\tsize=(1LL<<tall);",
			"\t\tA.resize(size, numeric_limits<ll>::max());",
			"\t\ttree.assign(tall+1, vector<ll>(size));",
			"\t\tsum.assign(tall+1, vector<__int128_t>(size+1));",
			"\t\tfor(ll i=0;i<=tall;i++){",
			"\t\t\ttree[i]=A;",
			"\t\t\tfor(ll j=0;j<size;j+=(1LL<<i)) sort(tree[i].begin()+j,tree[i].begin()+j+(1LL<<i));",
			"\t\t\tfor(ll j=0;j<size;j++) sum[i][j+1]=sum[i][j]+tree[i][j];",
			"\t\t}",
			"\t}",
			"\t/* [l,r) にある x 以下の要素数 */",
			"\tll count_leq(ll l,ll r,ll x) const {",
			"\t\tll t,ret=0;",
			"\t\twhile(l<r){",
			"\t\t\tfor(t=tall;0<=t;t--){",
			"\t\t\t\tif(l%(1LL<<t)!=0)continue;",
			"\t\t\t\tif(r<l+(1LL<<t))continue;",
			"\t\t\t\tauto first=tree[t].begin()+l;",
			"\t\t\t\tret+=upper_bound(first,first+(1LL<<t),x)-first;",
			"\t\t\t\tl+=(1LL<<t);",
			"\t\t\t\tbreak;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ret;",
			"\t}",
			"\t/* [l,r) にある x 以下の要素の総和（総和がllに収まること） */",
			"\tll sum_leq(ll l,ll r,ll x) const {",
			"\t\tll ret=0;",
			"\t\twhile(l<r) for(ll t=tall;0<=t;t--){",
			"\t\t\tif(l%(1LL<<t)!=0 || r<l+(1LL<<t)) continue;",
			"\t\t\tll id=upper_bound(tree[t].begin()+l,tree[t].begin()+l+(1LL<<t),x)-tree[t].begin();",
			"\t\t\tret+=(ll)(sum[t][id]-sum[t][l]); l+=(1LL<<t); break;",
			"\t\t}",
			"\t\treturn ret;",
			"\t}",
			"};",
		],
	},

