	"long long型用ランレングス圧縮": {
		"prefix": "rle_ll",
		"body": [
			"/* ランレングス圧縮後のデータフォーマット */",
			"struct rle_state {",
			"\tll data; // 数字",
			"\tll cnt; // 個数",
			"};",
			"",
			"/* ランレングス圧縮 */",
			"vector<rle_state> RLE(vector<ll> S) {",
			"\tvector<rle_state> ret;",
			"",
			"\tif (S.empty()) return ret;",
			"",
			"\tll c = S[0];",
			"\tll cnt = 1;",
			"\tfor(ll i = 1; i < S.size(); i++) {",
			"\t\tif(S[i] == c) cnt++;",
			"\t\telse {",
			"\t\t\tret.push_back({c, cnt});",
			"\t\t\tc = S[i]; cnt = 1;",
			"\t\t}",
			"\t}",
			"\tret.push_back({c, cnt});",
			"\treturn ret;",
			"}",
			"",
			"/* ランレングス圧縮の復元 */",
			"vector<ll> RLEinv(vector<rle_state> P) {",
			"\tvector<ll> ret;",
			"\tfor(auto p : P) {",
			"\t\trep(i, p.cnt) {",
			"\t\t\tret.push_back(p.data);",
			"\t\t}",
			"\t}",
			"\treturn ret;",
			"}",
			"",
			"\tvector<rle_state> rle = RLE(A);",
		],
	},

	"ウェーブレット行列": {
		"prefix": "wavelet_matrix",
		"body": [
			"/* NyaanNyaan/library/data-structure-2d/wavelet-matrix.hpp */",
			"",
			"#include <immintrin.h>",
			"",
			"struct bit_vector {",
			"\tusing u32 = uint32_t;",
			"\tusing i64 = int64_t;",
			"\tusing u64 = uint64_t;",
			"",
			"\tstatic constexpr u32 w = 64;",
			"\tvector<u64> block;",
			"\tvector<u32> count;",
			"\tu32 n, zeros;",
			"",
			"\tinline u32 get(u32 i) const { return u32(block[i / w] >> (i % w)) & 1u; }",
			"\tinline void set(u32 i) { block[i / w] |= 1LL << (i % w); }",
			"",
			"\tbit_vector() {}",
			"\tbit_vector(int _n) { init(_n); }",
			"\t__attribute__((optimize(\"O3\", \"unroll-loops\"))) void init(int _n) {",
			"\t\tn = zeros = _n;",
			"\t\tblock.resize(n / w + 1, 0);",
			"\t\tcount.resize(block.size(), 0);",
			"\t}",
			"",
			"\t__attribute__((target(\"popcnt\"))) void build() {",
			"\t\tfor (u32 i = 1; i < block.size(); ++i)",
			"\t\t\tcount[i] = count[i - 1] + _mm_popcnt_u64(block[i - 1]);",
			"\t\tzeros = rank0(n);",
			"\t}",
			"",
			"\tinline u32 rank0(u32 i) const { return i - rank1(i); }",
			"\t__attribute__((target(\"bmi2,popcnt\"))) inline u32 rank1(u32 i) const {",
			"\t\treturn count[i / w] + _mm_popcnt_u64(_bzhi_u64(block[i / w], i % w));",
			"\t}",
			"};",
			"",
			"template <typename T>",
			"struct WaveletMatrix {",
			"\tusing u32 = uint32_t;",
			"\tusing i64 = int64_t;",
			"\tusing u64 = uint64_t;",
			"",
			"\tint n, lg;",
			"\tvector<T> a;",
			"\tvector<bit_vector> bv;",
			"",
			"\tWaveletMatrix(u32 _n) : n(max<u32>(_n, 1)), a(n) {}",
			"\tWaveletMatrix(const vector<T>& _a) : n(_a.size()), a(_a) { if(n) build(); else lg=0; }",
			"",
			"\t__attribute__((optimize(\"O3\"))) void build() {",
			"\t\tif(a.empty()) { n=lg=0; bv.clear(); return; }",
			"\t\tlg = __lg(max<T>(*max_element(begin(a), end(a)), 1)) + 1;",
			"\t\tbv.assign(lg, n);",
			"\t\tvector<T> cur = a, nxt(n);",
			"\t\tfor (int h = lg - 1; h >= 0; --h) {",
			"\t\t\tfor (int i = 0; i < n; ++i)",
			"\t\t\t\tif ((cur[i] >> h) & 1) bv[h].set(i);",
			"\t\t\tbv[h].build();",
			"\t\t\tarray<decltype(begin(nxt)), 2> it{begin(nxt), begin(nxt) + bv[h].zeros};",
			"\t\t\tfor (int i = 0; i < n; ++i) *it[bv[h].get(i)]++ = cur[i];",
			"\t\t\tswap(cur, nxt);",
			"\t\t}",
			"\t\treturn;",
			"\t}",
			"",
			"\tvoid set(u32 i, const T& x) { ",
			"\t\tassert(x >= 0);",
			"\t\ta[i] = x; ",
			"\t}",
			"",
			"\tinline pair<u32, u32> succ0(int l, int r, int h) const {",
			"\t\treturn make_pair(bv[h].rank0(l), bv[h].rank0(r));",
			"\t}",
			"",
			"\tinline pair<u32, u32> succ1(int l, int r, int h) const {",
			"\t\tu32 l0 = bv[h].rank0(l);",
			"\t\tu32 r0 = bv[h].rank0(r);",
			"\t\tu32 zeros = bv[h].zeros;",
			"\t\treturn make_pair(l + zeros - l0, r + zeros - r0);",
			"\t}",
			"",
			"\t// return a[k]",
			"\tT access(u32 k) const {",
			"\t\tT ret = 0;",
			"\t\tfor (int h = lg - 1; h >= 0; --h) {",
			"\t\t\tu32 f = bv[h].get(k);",
			"\t\t\tret |= f ? T(1) << h : 0;",
			"\t\t\tk = f ? bv[h].rank1(k) + bv[h].zeros : bv[h].rank0(k);",
			"\t\t}",
			"\t\treturn ret;",
			"\t}",
			"",
			"\t// k-th (0-indexed) smallest number in a[l, r)",
			"\tT kth_smallest(u32 l, u32 r, u32 k) const {",
			"\t\tT res = 0;",
			"\t\tfor (int h = lg - 1; h >= 0; --h) {",
			"\t\t\tu32 l0 = bv[h].rank0(l), r0 = bv[h].rank0(r);",
			"\t\t\tif (k < r0 - l0)",
			"\t\t\t\tl = l0, r = r0;",
			"\t\t\telse {",
			"\t\t\t\tk -= r0 - l0;",
			"\t\t\t\tres |= (T)1 << h;",
			"\t\t\t\tl += bv[h].zeros - l0;",
			"\t\t\t\tr += bv[h].zeros - r0;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn res;",
			"\t}",
			"",
			"\t// k-th (0-indexed) largest number in a[l, r)",
			"\tT kth_largest(int l, int r, int k) {",
			"\t\treturn kth_smallest(l, r, r - l - k - 1);",
			"\t}",
			"",
			"\t// count i s.t. (l <= i < r) && (v[i] < upper)",
			"\tint range_freq(int l, int r, T upper) {",
			"\t\tif (upper >= (T(1) << lg)) return r - l;",
			"\t\tint ret = 0;",
			"\t\tfor (int h = lg - 1; h >= 0; --h) {",
			"\t\t\tbool f = (upper >> h) & 1;",
			"\t\t\tu32 l0 = bv[h].rank0(l), r0 = bv[h].rank0(r);",
			"\t\t\tif (f) {",
			"\t\t\t\tret += r0 - l0;",
			"\t\t\t\tl += bv[h].zeros - l0;",
			"\t\t\t\tr += bv[h].zeros - r0;",
			"\t\t\t} else {",
			"\t\t\t\tl = l0;",
			"\t\t\t\tr = r0;",
			"\t\t\t}",
			"\t\t}",
			"\t\treturn ret;",
			"\t}",
			"",
			"\tint range_freq(int l, int r, T lower, T upper) {",
			"\t\treturn range_freq(l, r, upper) - range_freq(l, r, lower);",
			"\t}",
			"",
			"\t// max v[i] s.t. (l <= i < r) && (v[i] < upper)",
			"\tT prev_value(int l, int r, T upper) {",
			"\t\tint cnt = range_freq(l, r, upper);",
			"\t\treturn cnt == 0 ? T(-1) : kth_smallest(l, r, cnt - 1);",
			"\t}",
			"",
			"\t// min v[i] s.t. (l <= i < r) && (lower <= v[i])",
			"\tT next_value(int l, int r, T lower) {",
			"\t\tint cnt = range_freq(l, r, lower);",
			"\t\treturn cnt == r - l ? T(-1) : kth_smallest(l, r, cnt);",
			"\t}",
			"};",
			"",
			"/**",
			" * WaveletMatrix(N): 要素数nのWaveletMatrixを生成",
			" * set(i, x): i番目の要素にxを代入",
			" * build(): データ構造を構築(これ以降setを呼び出しNG)",
			" * access(k): k番目の要素の値",
			" * kth_smallest(l, r, k): [l, r)でk(0-indexed)番目に小さい値",
			" * kth_largest(l, r, k): [l, r)でk(0-indexed)番目に大きい値",
			" * range_freq(l, r, upper): [l, r)でupper未満の要素の個数",
			" * prev_value(l, r, lower): [l, r)でupper未満の最後の値",
			" * next_value(l, r, lower): [l, r)でlower以上の最初の値",
			" */",
		],
	},

