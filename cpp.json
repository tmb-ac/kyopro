			"vector<pair<ll,ll>> segment(ll l,ll r){",
			"\tvector<pair<ll,ll>> res;",
			"\twhile(l!=r+1){",
			"\t\tll new_l=l;",
			"\t\tfor(ll two=1;l+two<=r+1;two*=2){",
			"\t\t\tif(l%two!=0)break;",
			"\t\t\tnew_l=l+two;",
			"\t\t}",
