	"階乗とnCr": {
		"prefix": [
			"factorial",
			"combination",
		],
		"body": [
			"// 階乗のサイズ・型の定義",
			"#define fact_size ${1:10000009}",
			"using Fact_type = ${2:mint};",
			"",
			"Fact_type factrial[fact_size];",
			"Fact_type factrial_inv[fact_size];",
			"",
			"// 階乗の初期化",
			"void set_fact(void) {",
			"\tfactrial[0] = 1;",
			"\tfactrial_inv[0] = 1;",
			"\tfor (ll i = 1; i < fact_size; i++) factrial[i] = factrial[i - 1] * i;",
			"\tfactrial_inv[fact_size - 1] = factrial[fact_size - 1].inv();",
			"\tfor (ll i = fact_size - 1; 0 < i; i--)",
			"\t\tfactrial_inv[i - 1] = factrial_inv[i] * i;",
			"}",
			"",
			"// 階乗の取得",
			"Fact_type fact(ll n) {",
			"\treturn factrial[n];",
			"}",
			"",
			"// 階乗の逆元の取得",
			"Fact_type fact_inv(ll n) {",
			"\treturn factrial_inv[n];",
			"}",
			"",
			"// nCrの取得",
			"Fact_type nCr(ll n, ll r) {",
			"\treturn factrial[n] * factrial_inv[r] * factrial_inv[n - r];",
			"}",
			"\tset_fact();",
		],
	},

	"直線の交点": {
		"prefix": [
			"cross_point",
			"kouten",
		],
		"body": [
			"// f(x) = ax + b と g(x) = cx + d の交点 x* を first/second の分数で返す",
			"pair<ll, ll> cross_point(ll a, ll b, ll c, ll d) {",
			"\t// ax + b = cx + d → (a - c)x = d - b",
			"\tif (a == c) return {0, 0}; // 平行または一致",
			"\tll num = d - b;",
			"\tll den = a - c;",
			"\t// 分母を正にする",
			"\tif (den < 0) {",
			"\t\tnum *= -1;",
			"\t\tden *= -1;",
			"\t}",
			"\t// 約分",
			"\tll g = gcd(abs(num), abs(den));",
			"\tnum /= g;",
			"\tden /= g;",
			"\treturn {num, den};",
			"}",
		],
	},

	"xor基底": {
		"prefix": [
			"xor_base",
			"kitei",
		],
		"body": [
			"/**",
			" * xor基底を求める",
			" * 基底には最上位ビットが他の基底で立っていないものが入る",
			" * 要素はsetで昇順に並ぶ",
			" */",
			"set<ll> xor_base(vector<ll> A) {",
			"\tset<ll> s;",
			"\tfor(auto a : A) {",
			"\t\tfor(auto b : s) {a = min(a, a ^ b);} // 基底の除去",
			"\t\tif(a == 0) continue;",
			"\t\tset<ll> ns = {a}; // 最上位ビットの掃き出し",
			"\t\tfor(auto b : s) {ns.insert(min(b, b ^ a));}",
			"\t\tswap(s, ns);",
			"\t}",
			"\treturn s;",
			"}",
			"\tset<ll>B=xor_base(A);",
		],
	},

	"ローリングハッシュ": {
		"prefix": "rolling_hash",
		"body": [
			"#include<atcoder/modint>",
			"#include<atcoder/segtree>",
			"using namespace atcoder;",
			"using rh_m1 = static_modint<998244353>;",
			"using rh_m2 = static_modint<1000000007>;",
			"/* 実行ごとに底を変え，固定入力による衝突を起こしにくくする */",
			"const int rh_base = 256 + chrono::steady_clock::now().time_since_epoch().count() % 900000000;",
			"struct rh_data { ll len; rh_m1 h1,p1; rh_m2 h2,p2; };",
			"rh_data rh_op(rh_data a, rh_data b) {",
			"\treturn {a.len+b.len, a.h1*b.p1+b.h1, a.p1*b.p1, a.h2*b.p2+b.h2, a.p2*b.p2};",
			"}",
			"rh_data rh_e() { return {0,0,1,0,1}; }",
			"rh_data rh_leaf(ll x) { return {1,rh_m1(x),rh_m1(rh_base),rh_m2(x),rh_m2(rh_base)}; }",
			"",
			"class rolling_hash {",
			"private:",
			"\tll N;",
			"\tsegtree<rh_data, rh_op, rh_e> seg;",
			"public:",
			"\t// 数列 V のローリングハッシュを初期化",
			"\trolling_hash(const vector<ll>& V) : N(V.size()), seg(N) {",
			"\t\tfor(ll i = 0; i < N; i++) {",
			"\t\t\tseg.set(i, rh_leaf(V[i]));",
			"\t\t}",
			"\t}",
			"",
			"\t// 文字列 S のローリングハッシュを初期化",
			"\trolling_hash(const string& S) : N(S.size()), seg(N) {",
			"\t\tfor(ll i = 0; i < N; i++) {",
			"\t\t\tseg.set(i, rh_leaf((unsigned char)S[i]+1));",
			"\t\t}",
			"\t}",
			"",
			"\t// サイズを取得",
			"\tll size(void) {",
			"\t\treturn N;",
			"\t}",
			"",
			"\t// id 番目の文字を val に更新",
			"\tvoid update(ll id, char val) {",
			"\t\tseg.set(id, rh_leaf((unsigned char)val+1));",
			"\t}",
			"",
			"\t// id 番目の値を val に更新",
			"\tvoid update(ll id, ll val) {",
			"\t\tseg.set(id, rh_leaf(val));",
			"\t}",
			"",
			"\t// [left, right] のハッシュ値を求める",
			"\tpair<int,int> val(ll left, ll right) const {",
			"\t\tauto h=seg.prod(left, right + 1);",
			"\t\treturn {h.h1.val(),h.h2.val()};",
			"\t}",
			"};",
		],
