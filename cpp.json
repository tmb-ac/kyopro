			"i128 abs( i128 x ) { return x < 0 ? -x : x; }",
			"",
			"// i128型を文字列に変換",
			"string to_string(i128 val) {",
			"\tstring ret = (val == 0) ? \"0\" : \"\";",
			"\tfor (i128 u = abs(val); 0 < u; u /= 10)",
			"\t\tret.push_back(char('0' + u % 10));",
			"\tif (val < 0) ret.push_back('-');",
			"\treverse(ret.begin(), ret.end());",
			"\treturn ret;",
			"}",
			"",
			"// 文字列をi128型に変換",
			"i128 stoi128(const string &s) {",
			"\ti128 val = 0;",
			"\tbool neg = s[0] == '-';",
			"\tfor (size_t i = neg; i < s.size(); i++)",
			"\t\tval = 10 * val + (s[i] - '0');",
			"\tif (neg) val = -val;",
