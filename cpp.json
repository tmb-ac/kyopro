	"グラフのトポロジカルソート": {
		"prefix": "graph",
		"body": [
			"class graph{",
			"private:",
			"\tll size;",
			"\tvector<vector<ll>>edge;",
			"\tvector<ll>in;",
			"public:",
			"\t/*トポロジカルソートの一意性*/",
			"\tbool unique;",
			"\tgraph(ll node_size){",
			"\t\tsize=node_size;",
			"\t\tedge=vector<vector<ll>>(size+1);",
			"\t\tin=vector<ll>(size+1,0);",
			"\t}",
			"\tvoid add_edge(ll from,ll to){",
			"\t\tedge[from].push_back(to);",
			"\t\tin[to]++;",
			"\t}",
			"\tvector<ll> topological_sort(void){",
			"\t\tunique=1;",
			"\t\tvector<ll>ret;",
			"\t\tvector<ll> indeg=in; // 元の入次数を壊さない",
			"\t\tqueue<ll>q;",
			"\t\tll now,next;",
			"\t\tfor(ll i=1;i<=size;i++){",
			"\t\t\tif(indeg[i]==0)q.push(i);",
			"\t\t}",
			"\t\twhile(q.size()!=0){",
			"\t\t\tif(q.size()!=1)unique=0;",
			"\t\t\tnow=q.front();q.pop();",
			"\t\t\tret.push_back(now);",
			"\t\t\tfor(ll i=0;i<edge[now].size();i++){",
			"\t\t\t\tnext=edge[now][i];",
			"\t\t\t\tindeg[next]--;",
			"\t\t\t\tif(indeg[next]!=0)continue;",
			"\t\t\t\tq.push(next);",
			"\t\t\t}",
			"\t\t}",
			"\t\tif(ret.size()!=size) unique=0; // DAGでない場合",
			"\t\treturn ret;",
			"\t}",
			"};",
		],
	},

