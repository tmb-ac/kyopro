			"public:",
			"\tint year, month, day;",
			"",
			"\tCalendar(int y, int m, int d) : year(y), month(m), day(d) {}",
			"",
			"\t/* うるう年判定 */",
			"\tbool isLeapYear(int y) {",
			"\t\tif (y % 4 == 0) {",
			"\t\t\tif (y % 100 == 0) {",
			"\t\t\t\tif (y % 400 == 0) return true;",
			"\t\t\t\treturn false;",
			"\t\t\t}",
			"\t\t\treturn true;",
			"\t\t}",
			"\t\treturn false;",
			"\t}",
			"",
			"\t/* 次の日に変更 */",
			"\tvoid next() {",
			"\t\tstatic int daysInMonth[] = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};",
			"\t\tif (isLeapYear(year)) daysInMonth[2] = 29;",
			"\t\telse daysInMonth[2] = 28;",
			"",
			"\t\tday++;",
			"\t\tif (day > daysInMonth[month]) {",
			"\t\t\tday = 1;",
			"\t\t\tmonth++;",
			"\t\t\tif (month > 12) {",
			"\t\t\t\tmonth = 1;",
			"\t\t\t\tyear++;",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"",
			"\t/* 前の日に変更 */",
			"\tvoid prev() {",
			"\t\tstatic int daysInMonth[] = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};",
			"\t\tif (isLeapYear(year)) daysInMonth[2] = 29;",
			"\t\telse daysInMonth[2] = 28;",
			"",
			"\t\tday--;",
			"\t\tif (day < 1) {",
			"\t\t\tmonth--;",
			"\t\t\tif (month < 1) {",
			"\t\t\t\tmonth = 12;",
			"\t\t\t\tyear--;",
			"\t\t\t}",
			"\t\t\tday = daysInMonth[month];",
			"\t\t}",
			"\t}",
			"};",
		],
	},

