			"struct rle_state {",
			"\tchar data; // 連続している数字",
			"\tll cnt; // 連続している個数",
			"};",
			"",
			"/* ランレングス圧縮 */",
			"vector<rle_state> RLE(string S) {",
			"\tvector<rle_state> ret;",
			"",
			"\tif (S.empty()) return ret;",
			"",
			"\tchar c = S[0];",
			"\tll cnt = 1;",
			"\tfor(ll i = 1; i < S.size(); i++) {",
			"\t\tif(S[i] == c) cnt++;",
			"\t\telse {",
			"\t\t\tret.push_back({c, cnt});",
			"\t\t\tc = S[i]; cnt = 1;",
			"\t\t}",
			"\t}",
			"\tret.push_back({c, cnt});",
			"\treturn ret;",
			"}",
			"",
			"/* ランレングス圧縮の復元 */",
			"string RLEinv(vector<rle_state> P) {",
			"\tstring ret;",
			"\tfor(auto p : P)",
			"\t\tret += string(p.cnt, p.data);",
			"\treturn ret;",
			"}",
			"",
			"\tvector<rle_state> rle = RLE(S);",
