	"最大重み独立集合": {
		"prefix": [
			"dokuritusyuugou",
			"independent_set",
		],
		"body": [
			"// 重み付き最大独立集合",
			"// Requirement: n <= 63",
			"// Complexity: exponential, O(1.381^n n)",
			"// Reference: https://www.slideshare.net/wata_orz/ss-12131479, p.34",
			"// Verified: https://judge.u-aizu.ac.jp/onlinejudge/description.jsp?id=3519",
			"template <class Weight> struct max_weight_independent_set {",
			"\tint V; // # of vertices",
			"\tvector<long long> conn;",
			"\tvector<Weight> ws;",
			"",
			"\tlong long solution_set; // Solution set is saved here: use (1) / not use (0)",
			"\tWeight eval_solution;   // optimal value",
			"",
			"private:",
			"\tlong long state;",
			"\tWeight eval_state;",
			"\tlong long avail;",
			"\tvoid mis_dfs() {",
			"\t\tstack<int, vector<int>> st;",
			"\t\tfor (bool retry = true; retry;) { // Pruning",
			"\t\t\tretry = false;",
			"\t\t\tfor (int i = 0; i < V; i++) {",
			"\t\t\t\tif (avail & (1LL << i)) {",
			"\t\t\t\t\tint nb = __builtin_popcountll(avail & conn[i]);",
			"\t\t\t\t\tif (nb == 0) {",
			"\t\t\t\t\t\tst.emplace(i), avail -= 1LL << i, state |= 1LL << i;",
			"\t\t\t\t\t\teval_state += ws[i];",
			"\t\t\t\t\t\tretry = true;",
			"\t\t\t\t\t}",
			"\t\t\t\t\tif (nb == 1) {",
			"\t\t\t\t\t\tint j = __builtin_ctzll(avail & conn[i]);",
			"\t\t\t\t\t\tif (ws[i] >= ws[j]) {",
			"\t\t\t\t\t\t\tst.emplace(i), avail -= 1LL << i, state |= 1LL << i;",
			"\t\t\t\t\t\t\teval_state += ws[i];",
			"\t\t\t\t\t\t\tretry = true;",
			"\t\t\t\t\t\t\tst.emplace(j), avail &= ~(1LL << j);",
			"\t\t\t\t\t\t}",
			"\t\t\t\t\t}",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"",
			"\t\tif (eval_state > eval_solution) eval_solution = eval_state, solution_set = state;",
			"",
			"\t\tint d = -1, n = -1;",
			"\t\tfor (int i = 0; i < V; i++) {",
			"\t\t\tif (avail & (1LL << i)) {",
			"\t\t\t\tint c = __builtin_popcountll(avail & conn[i]);",
			"\t\t\t\tif (c > d) d = c, n = i;",
			"\t\t\t}",
			"\t\t}",
			"",
			"\t\tif (d >= 0) {",
			"\t\t\tlong long nxt = avail & conn[n];",
			"\t\t\tavail -= 1LL << n;",
			"\t\t\tmis_dfs();",
			"\t\t\tstate |= 1LL << n;",
			"\t\t\teval_state += ws[n];",
			"\t\t\tavail &= ~nxt;",
			"\t\t\tmis_dfs();",
			"\t\t\tavail |= nxt;",
			"\t\t\tavail |= 1LL << n;",
			"\t\t\tstate &= ~(1LL << n);",
			"\t\t\teval_state -= ws[n];",
			"\t\t}",
			"",
			"\t\tfor (; st.size(); st.pop()) {",
			"\t\t\tint i = st.top();",
			"\t\t\tavail |= 1LL << i;",
			"\t\t\tif ((state >> i) & 1LL) state -= 1LL << i, eval_state -= ws[i];",
			"\t\t}",
			"\t}",
			"",
			"public:",
			"\tmax_weight_independent_set(const int V)",
			"\t\t: V(V), conn(V), ws(V, Weight(1)), solution_set(0), eval_solution(Weight()), state(0),",
			"\t\t  eval_state(Weight()), avail((1LL << V) - 1) {}",
			"\tmax_weight_independent_set(const vector<Weight> &ws_)",
			"\t\t: max_weight_independent_set(ws_.size()) {",
			"\t\tws = ws_;",
			"\t}",
			"",
			"\tvoid add_edge(int u, int v) {",
			"\t\tassert(u != v);",
			"\t\tassert(0 <= u and u < V);",
			"\t\tassert(0 <= v and v < V);",
			"\t\tconn[u] |= 1LL << v;",
			"\t\tconn[v] |= 1LL << u;",
			"\t}",
			"",
			"\tWeight solve() {",
			"\t\tstate = 0, eval_state = Weight(), avail = (1LL << V) - 1;",
			"\t\tsolution_set = 0, eval_solution = Weight();",
			"\t\tmis_dfs();",
			"\t\treturn eval_solution;",
			"\t}",
			"};",
			"\tll N,M;",
			"\tcin>>N>>M;",
			"\tvector<long long> weight(N);",
			"\trep(i,N)cin>>weight[i];",
			"\tmax_weight_independent_set<long long> solver(weight);",
			"\trep(i,M){",
			"\t\tll U,V;",
			"\t\tcin>>U>>V;",
			"\t\tU--;V--;",
			"\t\tsolver.add_edge(U,V);",
			"\t}",
			"",
			"\t// 最大重み独立集合の最大値",
			"\tll sum = solver.solve();",
			"",
			"\t// 最大値を取る頂点集合",
			"\tll mask = solver.solution_set;",
			"\tvector<bool>use(N);",
			"\trep(i,N)use[i]=((mask>>i)&1);",
		],
	},

	"区間二乗和遅延セグ木": {
		"prefix": "square_sum",
		"body": [
			"#include <atcoder/lazysegtree>",
			"",
			"/* SQ_Val_type: 区間の値の型 */",
			"using SQ_Val_type = ll; // mint, double, ll",
			"/* SQ_S_type:遅延セグ木で使うデータの型 (区間の合計，二乗和，長さ) */",
			"struct SQ_S_type {",
			"\tSQ_Val_type sum, sqsum;",
			"\tll len;",
			"};",
			"/* SQ_F_type:遅延セグ木で使う区間更新の型 */",
			"using SQ_F_type = SQ_Val_type;",
			"/* SQ_op:区間取得に用いる演算 */",
			"SQ_S_type SQ_op(SQ_S_type a, SQ_S_type b) {",
			"\treturn SQ_S_type{a.sum + b.sum, a.sqsum + b.sqsum, a.len + b.len};",
			"}",
			"/* SQ_e:SQ_opを用いてもデータを変化させない値 */",
			"SQ_S_type SQ_e() { return SQ_S_type{SQ_Val_type(0), SQ_Val_type(0), 0}; }",
			"/* SQ_mpg: data への区間更新の方法 (区間に f を足す) */",
			"SQ_S_type SQ_mpg(SQ_F_type f, SQ_S_type x) {",
			"\tSQ_Val_type add = SQ_Val_type(f);",
			"\tSQ_Val_type len = SQ_Val_type(x.len);",
			"\tSQ_Val_type new_sqsum = x.sqsum + SQ_Val_type(2) * add * x.sum + add * add * len;",
			"\tSQ_Val_type new_sum = x.sum + add * len;",
			"\treturn SQ_S_type{new_sum, new_sqsum, x.len};",
			"}",
			"/* SQ_cmp: 区間更新の重複 f(g(x)) を定義 (加算の合成は足し算)",
			"mapping(f, mapping(g, x)) == mapping(composition(f,g), x) */",
			"SQ_F_type SQ_cmp(SQ_F_type f, SQ_F_type g) { return f + g; }",
			"/* SQ_id: mapping を用いてもデータを変化させない値 */",
			"SQ_F_type SQ_id() { return 0; }",
			"",
			"\tlazy_segtree<",
			"\t\tSQ_S_type, SQ_op, SQ_e, SQ_F_type, SQ_mpg,",
			"\t\tSQ_cmp, SQ_id",
			"\t> lseg(",
			"\t\tvector<SQ_S_type>(N, SQ_S_type{SQ_Val_type(0), SQ_Val_type(0), 1})",
			"\t);",
		],
	},

	"永続セグ木": {
		"prefix": [
			"persistentsegmenttree",
			"eizokuseguki",
		],
		"body": [
			"template <typename T, typename F, int NODES = 20000000>",
			"struct PersistentSegmentTree {",
			"\tstruct Node {",
			"\t\tT data;",
			"\t\tNode *l, *r;",
			"\t\tNode() {}",
			"\t\tNode(const T &_data) : data(_data), l(nullptr), r(nullptr) {}",
			"\t};",
			"",
			"\tNode *pool;",
			"\tint pid;",
			"\tll N;",
			"\tconst F f;",
			"\tconst T ID;",
			"\tNode *nil;",
			"\tvector<Node *> roots;",
			"",
			"\tPersistentSegmentTree(const vector<T> &v, const F &f_, const T &ID_)",
			"\t\t\t: pid(0), f(f_), ID(ID_), nil(nullptr) {",
			"\t\tassert(!v.empty());",
			"\t\tpool = new Node[NODES];",
			"\t\tnil = my_new(ID);",
			"\t\tnil->l = nil->r = nil;",
			"\t\troots.reserve(262144);",
			"\t\troots.push_back(build(v));",
			"\t}",
			"",
			"\tPersistentSegmentTree(const ll &N_, const F &f_, const T &ID_)",
			"\t\t\t: pid(0), N(N_), f(f_), ID(ID_), nil(nullptr) {",
			"\t\tassert(0 < N);",
			"\t\tpool = new Node[NODES];",
			"\t\tnil = my_new(ID);",
			"\t\tnil->l = nil->r = nil;",
			"\t\troots.reserve(262144);",
			"\t\troots.push_back(nil);",
			"\t}",
			"",
			"\tNode *my_new(const T &data) {",
			"\t\tassert(pid < NODES);",
			"\t\tpool[pid].data = data;",
			"\t\tpool[pid].l = pool[pid].r = nil;",
			"\t\treturn &(pool[pid++]);",
			"\t}",
			"",
			"\tNode *merge(Node *l, Node *r) {",
			"\t\tassert(pid < NODES);",
			"\t\tpool[pid].data = f(l->data, r->data);",
			"\t\tpool[pid].l = l;",
			"\t\tpool[pid].r = r;",
			"\t\treturn &(pool[pid++]);",
			"\t}",
			"",
			"\tNode *build(const vector<T> &v) {",
			"\t\tN = (ll)v.size();",
			"\t\treturn build(0, (ll)v.size(), v);",
			"\t}",
			"",
			"\tNode *build(ll l, ll r, const vector<T> &v) {",
			"\t\tif (l + 1 == r) return my_new(v[l]);",
			"\t\tll m = (l + r) >> 1;",
			"\t\treturn merge(build(l, m, v), build(m, r, v));",
			"\t}",
			"",
			" private:",
			"\tNode *update_(ll a, const T &x, Node *n, ll l, ll r) {",
			"\t\tif (l + 1 == r) return my_new(x);",
			"\t\tll m = (l + r) >> 1;",
			"\t\tif (a < m) return merge(update_(a, x, n->l, l, m), n->r);",
			"\t\treturn merge(n->l, update_(a, x, n->r, m, r));",
			"\t}",
			"\tNode *add_(ll a, const T &x, Node *n, ll l, ll r) {",
			"\t\tif (l + 1 == r) return my_new(f(x, n->data));",
			"\t\tll m = (l + r) >> 1;",
			"\t\tif (a < m) return merge(add_(a, x, n->l, l, m), n->r);",
			"\t\treturn merge(n->l, add_(a, x, n->r, m, r));",
			"\t}",
			"\tT query_(ll a, ll b, Node *n, ll l, ll r) {",
			"\t\tif (n == nil) return ID;",
			"\t\tif (r <= a or b <= l) return ID;",
			"\t\tif (a <= l and r <= b) return n->data;",
			"\t\tll m = (l + r) >> 1;",
			"\t\treturn f(query_(a, b, n->l, l, m), query_(a, b, n->r, m, r));",
			"\t}",
			"",
			" public:",
			"\tNode *update(Node *n, ll k, const T &x) {",
			"\t\tNode *root = update_(k, x, n, 0, N);",
			"\t\troots.push_back(root);",
			"\t\treturn root;",
			"\t}",
			"\tNode *update(int t, ll k, const T &x) {",
			"\t\tNode *root = update_(k, x, roots[t], 0, N);",
			"\t\troots.push_back(root);",
			"\t\treturn root;",
			"\t}",
			"\tNode *update(ll k, const T &x) {",
			"\t\tNode *root = update_(k, x, roots.back(), 0, N);",
			"\t\troots.push_back(root);",
			"\t\treturn root;",
			"\t}",
			"",
			"\tNode *add(Node *n, ll k, const T &x) {",
			"\t\tNode *root = add_(k, x, n, 0, N);",
			"\t\troots.push_back(root);",
			"\t\treturn root;",
			"\t}",
			"\tNode *add(int t, ll k, const T &x) {",
			"\t\tNode *root = add_(k, x, roots[t], 0, N);",
			"\t\troots.push_back(root);",
			"\t\treturn root;",
			"\t}",
			"\tNode *add(ll k, const T &x) {",
			"\t\tNode *root = add_(k, x, roots.back(), 0, N);",
			"\t\troots.push_back(root);",
			"\t\treturn root;",
			"\t}",
			"",
			"\tT query(Node *n, ll a, ll b) { return query_(a, b, n, 0, N); }",
			"\tT query(int t, ll a, ll b) { return query_(a, b, roots[t], 0, N); }",
			"\tT query(ll a, ll b) { return query_(a, b, roots.back(), 0, N); }",
			"",
			"\tNode *new_tree() { return nil; }",
			"};",
			"",
			"/* S_type:セグ木で使う型 */",
			"using S_type = ll;",
			"/* op:セグ木に載せたい演算 */",
			"S_type op(S_type a, S_type b) {return a + b;}",
			"/* e:opを用いてもデータを変化させない値 */",
			"S_type e(void) {return 0;}",
			"",
			"/**",
			" * @brief 永続セグメント木",
			" * @docs docs/segment-tree/persistent-segtree.md",
			" * ",
			" * 使い方",
			" * update(Node *n, k, x) := nを根とする木を更新元とする",
			" * update(int t, k, x) := t回目の更新の後の木を更新元とする",
			" * update(k, x) := 最新の木を更新元とする",
			" * new_tree() := 空の木を返す",
			" * ",
			" * query(Node *n, l, r + 1) := [l,r]の区間クエリを行う",
			" * ",
			" * roots[] := updateごとのrootが格納．k回目の更新後はroots[k]に入る",
			" */",
			"\tPersistentSegmentTree<S_type, decltype(&op)> seg(vector<ll>(N + 1, 0), &op, e());",
			"",
		],
	},

	"桁DP": {
		"prefix": [
			"digitdp",
			"ketadp",
		],
		"body": [
			"// https://atcoder.jp/contests/abc336/tasks/abc336_e",
			"#include<bits/stdc++.h>",
			"using namespace std;",
			"#define ll long long",
			"#define rep(i, N) for(ll i = 0; i < N; i++)",
			"",
			"// 最大桁数",
			"#define MAX_DIGIT 20",
			"using ans_type = ll;",
			"",
			"ll N[MAX_DIGIT + 9] = {0};",
			"ll D;",
			"",
			"/** ",
			" * dp[桁][境界?][leading0?]  [s1][s2]",
			" * s1 := 余り",
			" * s2 := 桁和",
			" */",
			"ans_type dp[MAX_DIGIT+9][2][2]  [140][140] = {0};",
			"bool\tvis[MAX_DIGIT+9][2][2]  [140][140] = {0};",
			"",
			"ans_type seek(",
			"\tll digit, bool bound, bool lead0,",
			"\tll s1, ll s2",
			") {",
			"\tif(vis[digit][bound][lead0][s1][s2]) {",
			"\t\treturn dp[digit][bound][lead0][s1][s2];",
			"\t}",
			"\tvis[digit][bound][lead0][s1][s2] = true;",
			"\tans_type ret = 0;",
			"",
			"\t// 寄与を計算",
			"\tif(digit == 0) {",
			"\t\tret = (s1 == 0 && s2 == D && !lead0);",
			"\t\tdp[digit][bound][lead0][s1][s2] = ret;",
			"\t\treturn ret;",
			"\t}",
			"\t",
			"\t// 遷移",
			"\trep(i, (bound ? N[digit] + 1 : 10)) {",
			"\t\tbool nlead0 = (lead0 && i == 0);",
			"\t\tll ns1 = s1;",
			"\t\tll ns2 = s2;",
			"",
			"\t\tns1 *= 10;",
			"\t\tns1 += i;",
			"\t\tns1 %= D;",
			"",
			"\t\tns2 += i;",
			"",
			"\t\tret += seek(",
			"\t\t\tdigit - 1, (bound && i == N[digit]), nlead0,",
			"\t\t\tns1, ns2",
			"\t\t);",
			"\t}",
			"",
			"\tdp[digit][bound][lead0][s1][s2] = ret;",
			"\treturn ret;",
			"}",
			"",
			"int main(void){",
			"\tstring S;",
			"\tcin>>S;",
			"",
			"\trep(i,S.size()) N[S.size()-i] = S[i] - '0';",
			"\tll ans = 0;",
			"\tfor(D=1;D<=9*14;D++){",
			"\t\tans += seek(S.size(), 1, 1, 0, 0);",
			"\t\tmemset(vis, 0, sizeof(vis));",
			"\t}",
			"",
			"\tcout<<ans<<endl;",
			"",
			"\treturn 0;",
			"}",
		],
	},

	"SWAG: Sliding Window Aggregation": {
		"prefix": "swag",
		"body": [
			"template <class S, S (*op)(S, S), S (*e)()> struct SWAG {",
			"private:",
			"\t// 各要素は (値, その位置までの積) を持つ．",
			"\tvector<pair<S, S>> front_stack, back_stack;",
			"",
			"\tvoid move_back_to_front() {",
			"\t\twhile (!back_stack.empty()) {",
			"\t\t\tS value = move(back_stack.back().first);",
			"\t\t\tback_stack.pop_back();",
			"\t\t\tS aggregate = front_stack.empty()",
			"\t\t\t\t? value",
			"\t\t\t\t: op(value, front_stack.back().second);",
			"\t\t\tfront_stack.emplace_back(move(value), move(aggregate));",
			"\t\t}",
			"\t}",
			"",
			"public:",
			"\tSWAG() = default;",
			"",
			"\tvoid push(const S& value) {",
			"\t\tS aggregate = back_stack.empty()",
			"\t\t\t? value",
			"\t\t\t: op(back_stack.back().second, value);",
			"\t\tback_stack.emplace_back(value, move(aggregate));",
			"\t}",
			"",
			"\tvoid pop() {",
			"\t\tassert(!empty());",
			"\t\tif (front_stack.empty()) move_back_to_front();",
			"\t\tfront_stack.pop_back();",
			"\t}",
			"",
			"\t// 全要素の積を返す．空なら単位元を返す．",
			"\tS fold() const {",
			"\t\tif (front_stack.empty() && back_stack.empty()) return e();",
			"\t\tif (front_stack.empty()) return back_stack.back().second;",
			"\t\tif (back_stack.empty()) return front_stack.back().second;",
			"\t\treturn op(front_stack.back().second, back_stack.back().second);",
			"\t}",
			"",
			"\tbool empty() const {",
			"\t\treturn front_stack.empty() && back_stack.empty();",
			"\t}",
			"",
			"\tsize_t size() const {",
			"\t\treturn front_stack.size() + back_stack.size();",
			"\t}",
			"};",
			"",
			"/* S_type: SWAGで使う型 */",
			"using S_type = ll;",
			"/* op: SWAGに載せたい演算 */",
			"S_type op(S_type x, S_type y) {",
			"\tS_type ret=x+y;",
			"\treturn ret;",
			"}",
			"/* e: opを用いてもデータを変化させない値 */",
			"S_type e(void) {",
			"\treturn {0};",
			"}",
			"\tSWAG<S_type, op, e> sw;",
		],
	},

	"Segment Tree Beats": {
		"prefix": [
			"segtreebeats",
			"beats",
		],
		"body": [
			"namespace SegmentTreeBeats {",
			"",
			"template <class T, class Sum = ll>",
			"class ChminChmaxAddTree {",
			"public:",
			"\tstruct S {",
			"\t\tSum sum;",
			"\t\tT min;",
			"\t\tT max;",
			"\t};",
			"",
			"\tstruct Chmin { T x; };",
			"\tstruct Chmax { T x; };",
			"\tstruct Add { T x; };",
			"",
			"private:",
			"\tstatic constexpr T INF = numeric_limits<T>::max();",
			"\tstatic constexpr T NEG_INF = numeric_limits<T>::lowest();",
			"",
			"\tstruct Node {",
			"\t\tSum sum = 0;",
			"\t\tT max1 = NEG_INF, max2 = NEG_INF;",
			"\t\tT min1 = INF, min2 = INF;",
			"\t\tT lazy_add = 0;",
			"\t\tint max_count = 0, min_count = 0;",
			"\t\tint size = 0;",
			"\t};",
			"",
			"\tint _n = 0;",
			"\tvector<Node> d;",
			"",
			"\tstatic Node make_leaf(T x) {",
			"\t\tNode a;",
			"\t\ta.sum = x;",
			"\t\ta.max1 = a.min1 = x;",
			"\t\ta.max_count = a.min_count = a.size = 1;",
			"\t\treturn a;",
			"\t}",
			"",
			"\tstatic Node merge(const Node& l, const Node& r) {",
			"\t\tif (l.size == 0) return r;",
			"\t\tif (r.size == 0) return l;",
			"\t\tNode a;",
			"\t\ta.size = l.size + r.size;",
			"\t\ta.sum = l.sum + r.sum;",
			"",
			"\t\tif (l.max1 == r.max1) {",
			"\t\t\ta.max1 = l.max1;",
			"\t\t\ta.max2 = max(l.max2, r.max2);",
			"\t\t\ta.max_count = l.max_count + r.max_count;",
			"\t\t} else if (l.max1 > r.max1) {",
			"\t\t\ta.max1 = l.max1;",
			"\t\t\ta.max2 = max(l.max2, r.max1);",
			"\t\t\ta.max_count = l.max_count;",
			"\t\t} else {",
			"\t\t\ta.max1 = r.max1;",
			"\t\t\ta.max2 = max(l.max1, r.max2);",
			"\t\t\ta.max_count = r.max_count;",
			"\t\t}",
			"",
			"\t\tif (l.min1 == r.min1) {",
			"\t\t\ta.min1 = l.min1;",
			"\t\t\ta.min2 = min(l.min2, r.min2);",
			"\t\t\ta.min_count = l.min_count + r.min_count;",
			"\t\t} else if (l.min1 < r.min1) {",
			"\t\t\ta.min1 = l.min1;",
			"\t\t\ta.min2 = min(l.min2, r.min1);",
			"\t\t\ta.min_count = l.min_count;",
			"\t\t} else {",
			"\t\t\ta.min1 = r.min1;",
			"\t\t\ta.min2 = min(l.min1, r.min2);",
			"\t\t\ta.min_count = r.min_count;",
			"\t\t}",
			"\t\treturn a;",
			"\t}",
			"",
			"\tvoid update(int k) { d[k] = merge(d[2 * k], d[2 * k + 1]); }",
			"",
			"\tvoid apply_add(int k, T x) {",
			"\t\tNode& a = d[k];",
			"\t\ta.sum += Sum(x) * a.size;",
			"\t\ta.max1 += x;",
			"\t\tif (a.max2 != NEG_INF) a.max2 += x;",
			"\t\ta.min1 += x;",
			"\t\tif (a.min2 != INF) a.min2 += x;",
			"\t\ta.lazy_add += x;",
			"\t}",
			"",
			"\tvoid apply_chmin(int k, T x) {",
			"\t\tNode& a = d[k];",
			"\t\tif (a.max1 <= x) return;",
			"\t\ta.sum += Sum(x - a.max1) * a.max_count;",
			"\t\tif (a.min1 == a.max1) a.min1 = x;",
			"\t\telse if (a.min2 == a.max1) a.min2 = x;",
			"\t\ta.max1 = x;",
			"\t}",
			"",
			"\tvoid apply_chmax(int k, T x) {",
			"\t\tNode& a = d[k];",
			"\t\tif (a.min1 >= x) return;",
			"\t\ta.sum += Sum(x - a.min1) * a.min_count;",
			"\t\tif (a.max1 == a.min1) a.max1 = x;",
			"\t\telse if (a.max2 == a.min1) a.max2 = x;",
			"\t\ta.min1 = x;",
			"\t}",
			"",
			"\tvoid push(int k) {",
			"\t\tif (d[k].size <= 1) return;",
			"\t\tif (d[k].lazy_add != 0) {",
			"\t\t\tapply_add(2 * k, d[k].lazy_add);",
			"\t\t\tapply_add(2 * k + 1, d[k].lazy_add);",
			"\t\t\td[k].lazy_add = 0;",
			"\t\t}",
			"\t\tif (d[2 * k].max1 > d[k].max1) apply_chmin(2 * k, d[k].max1);",
			"\t\tif (d[2 * k + 1].max1 > d[k].max1) apply_chmin(2 * k + 1, d[k].max1);",
			"\t\tif (d[2 * k].min1 < d[k].min1) apply_chmax(2 * k, d[k].min1);",
			"\t\tif (d[2 * k + 1].min1 < d[k].min1) apply_chmax(2 * k + 1, d[k].min1);",
			"\t}",
			"",
			"\tvoid build(int k, int l, int r, const vector<T>& v) {",
			"\t\tif (r - l == 1) {",
			"\t\t\td[k] = make_leaf(v[l]);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tint m = (l + r) / 2;",
			"\t\tbuild(2 * k, l, m, v);",
			"\t\tbuild(2 * k + 1, m, r, v);",
			"\t\tupdate(k);",
			"\t}",
			"",
			"\tvoid set_impl(int p, T x, int k, int l, int r) {",
			"\t\tif (r - l == 1) {",
			"\t\t\td[k] = make_leaf(x);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tpush(k);",
			"\t\tint m = (l + r) / 2;",
			"\t\tif (p < m) set_impl(p, x, 2 * k, l, m);",
			"\t\telse set_impl(p, x, 2 * k + 1, m, r);",
			"\t\tupdate(k);",
			"\t}",
			"",
			"\tT get_impl(int p, int k, int l, int r) {",
			"\t\tif (r - l == 1) return d[k].min1;",
			"\t\tpush(k);",
			"\t\tint m = (l + r) / 2;",
			"\t\treturn p < m ? get_impl(p, 2 * k, l, m)",
			"\t\t\t\t\t : get_impl(p, 2 * k + 1, m, r);",
			"\t}",
			"",
			"\tvoid apply_impl(int ql, int qr, Chmin f, int k, int l, int r) {",
			"\t\tif (r <= ql || qr <= l || d[k].max1 <= f.x) return;",
			"\t\tif (ql <= l && r <= qr && d[k].max2 < f.x) {",
			"\t\t\tapply_chmin(k, f.x);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tpush(k);",
			"\t\tint m = (l + r) / 2;",
			"\t\tapply_impl(ql, qr, f, 2 * k, l, m);",
			"\t\tapply_impl(ql, qr, f, 2 * k + 1, m, r);",
			"\t\tupdate(k);",
			"\t}",
			"",
			"\tvoid apply_impl(int ql, int qr, Chmax f, int k, int l, int r) {",
			"\t\tif (r <= ql || qr <= l || d[k].min1 >= f.x) return;",
			"\t\tif (ql <= l && r <= qr && d[k].min2 > f.x) {",
			"\t\t\tapply_chmax(k, f.x);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tpush(k);",
			"\t\tint m = (l + r) / 2;",
			"\t\tapply_impl(ql, qr, f, 2 * k, l, m);",
			"\t\tapply_impl(ql, qr, f, 2 * k + 1, m, r);",
			"\t\tupdate(k);",
			"\t}",
			"",
			"\tvoid apply_impl(int ql, int qr, Add f, int k, int l, int r) {",
			"\t\tif (r <= ql || qr <= l) return;",
			"\t\tif (ql <= l && r <= qr) {",
			"\t\t\tapply_add(k, f.x);",
			"\t\t\treturn;",
			"\t\t}",
			"\t\tpush(k);",
			"\t\tint m = (l + r) / 2;",
			"\t\tapply_impl(ql, qr, f, 2 * k, l, m);",
			"\t\tapply_impl(ql, qr, f, 2 * k + 1, m, r);",
			"\t\tupdate(k);",
			"\t}",
			"",
			"\tNode prod_impl(int ql, int qr, int k, int l, int r) {",
			"\t\tif (r <= ql || qr <= l) return Node{};",
			"\t\tif (ql <= l && r <= qr) return d[k];",
			"\t\tpush(k);",
			"\t\tint m = (l + r) / 2;",
			"\t\treturn merge(prod_impl(ql, qr, 2 * k, l, m),",
			"\t\t\t\t\t prod_impl(ql, qr, 2 * k + 1, m, r));",
			"\t}",
			"",
			"\tstatic S to_result(const Node& a) {",
			"\t\tif (a.size == 0) return {0, INF, NEG_INF};",
			"\t\treturn {a.sum, a.min1, a.max1};",
			"\t}",
			"",
			"public:",
			"\tChminChmaxAddTree() = default;",
			"",
			"\texplicit ChminChmaxAddTree(int n) : ChminChmaxAddTree(vector<T>(n)) {}",
			"",
			"\texplicit ChminChmaxAddTree(const vector<T>& v)",
			"\t\t: _n((int)v.size()), d(max(1, 4 * (int)v.size())) {",
			"\t\tif (_n) build(1, 0, _n, v);",
			"\t}",
			"",
			"\tint size() const { return _n; }",
			"",
			"\tvoid set(int p, T x) {",
			"\t\tassert(0 <= p && p < _n);",
			"\t\tset_impl(p, x, 1, 0, _n);",
			"\t}",
			"",
			"\tT get(int p) {",
			"\t\tassert(0 <= p && p < _n);",
			"\t\treturn get_impl(p, 1, 0, _n);",
			"\t}",
			"",
			"\tS prod(int l, int r) {",
			"\t\tassert(0 <= l && l <= r && r <= _n);",
			"\t\tif (l == r) return {0, INF, NEG_INF};",
			"\t\treturn to_result(prod_impl(l, r, 1, 0, _n));",
			"\t}",
			"",
			"\tS all_prod() const {",
			"\t\treturn _n == 0 ? S{0, INF, NEG_INF} : to_result(d[1]);",
			"\t}",
			"",
			"\tvoid apply(int p, Chmin f) { apply(p, p + 1, f); }",
			"\tvoid apply(int p, Chmax f) { apply(p, p + 1, f); }",
			"\tvoid apply(int p, Add f) { apply(p, p + 1, f); }",
			"",
			"\tvoid apply(int l, int r, Chmin f) {",
			"\t\tassert(0 <= l && l <= r && r <= _n);",
			"\t\tif (l != r) apply_impl(l, r, f, 1, 0, _n);",
			"\t}",
			"",
			"\tvoid apply(int l, int r, Chmax f) {",
			"\t\tassert(0 <= l && l <= r && r <= _n);",
			"\t\tif (l != r) apply_impl(l, r, f, 1, 0, _n);",
			"\t}",
			"",
			"\tvoid apply(int l, int r, Add f) {",
			"\t\tassert(0 <= l && l <= r && r <= _n);",
			"\t\tif (l != r) apply_impl(l, r, f, 1, 0, _n);",
			"\t}",
			"};",
			"",
			"}  // namespace SegmentTreeBeats",
			"",
			"using Tree = SegmentTreeBeats::ChminChmaxAddTree<ll>;",
			"",
			"\tTree seg(500009);",
			"\t// 下記以外はACLと同じ．区間は半開区間 [l, r)",
			"\t// seg.apply(l, r, Tree::Chmin{x});",
			"\t// seg.apply(l, r, Tree::Chmax{x});",
			"\t// seg.apply(l, r, Tree::Add{x});",
			"\t// auto result = seg.prod(l, r);  // {sum, min, max}",
		],
	},

	"最長増加減少部分列": {
		"prefix": [
			"lis",
			"lds",
		],
		"body": [
			"enum class SubsequenceOrder {",
			"\tStrict,\t // 狭義:  < または >",
			"\tNonStrict,  // 広義: <= または >=",
			"};",
			"",
			"struct SubsequenceInfo {",
			"\t// 長さ",
			"\tint length;",
			"\t// position[i] = a[i] を含む最長部分列が存在するときの位置 (1-indexed)",
			"\t// そのような最長部分列が存在しないときは -1",
			"\tvector<int> position;",
			"};",
			"",
			"namespace subsequence_detail {",
			"",
			"template <class T, class Compare>",
			"vector<int> ending_lengths(",
			"\tconst vector<T>& a,",
			"\tSubsequenceOrder order,",
			"\tCompare comp",
			") {",
			"\tvector<T> tails;",
			"\tvector<int> res(a.size());",
			"",
			"\tfor (int i = 0; i < (int)a.size(); ++i) {",
			"\t\tauto it = order == SubsequenceOrder::Strict",
			"\t\t\t\t\t  ? lower_bound(tails.begin(), tails.end(), a[i], comp)",
			"\t\t\t\t\t  : upper_bound(tails.begin(), tails.end(), a[i], comp);",
			"\t\tres[i] = (int)(it - tails.begin()) + 1;",
			"\t\tif (it == tails.end()) tails.push_back(a[i]);",
			"\t\telse *it = a[i];",
			"\t}",
			"\treturn res;",
			"}",
			"",
			"template <class T, class Compare, class ReverseCompare>",
			"SubsequenceInfo longest_subsequence(",
			"\tconst vector<T>& a,",
			"\tSubsequenceOrder order,",
			"\tCompare comp,",
			"\tReverseCompare reverse_comp",
			") {",
			"\tif (a.empty()) return {0, {}};",
			"",
			"\tvector<int> left = ending_lengths(a, order, comp);",
			"\tvector<T> reversed(a.rbegin(), a.rend());",
			"\tvector<int> reversed_right = ending_lengths(reversed, order, reverse_comp);",
			"",
			"\tconst int n = (int)a.size();",
			"\tconst int length = *max_element(left.begin(), left.end());",
			"\tvector<int> position(n, -1);",
			"\tfor (int i = 0; i < n; ++i) {",
			"\t\tint right = reversed_right[n - 1 - i];",
			"\t\tif (left[i] + right - 1 == length) position[i] = left[i];",
			"\t}",
			"\treturn {length, move(position)};",
			"}",
			"",
			"}  // namespace subsequence_detail",
			"",
			"// 最長増加部分列",
			"template <class T>",
			"SubsequenceInfo lis(",
			"\tconst vector<T>& a,",
			"\tSubsequenceOrder order",
			") {",
			"\treturn subsequence_detail::longest_subsequence(",
			"\t\ta, order, less<T>{}, greater<T>{}",
			"\t);",
			"}",
			"",
			"// 最長減少部分列",
			"template <class T>",
			"SubsequenceInfo lds(",
			"\tconst vector<T>& a,",
			"\tSubsequenceOrder order",
			") {",
			"\treturn subsequence_detail::longest_subsequence(",
			"\t\ta, order, greater<T>{}, less<T>{}",
			"\t);",
			"}",
			"",
			"// lds(A, SubsequenceOrder::NonStrict)",
		],
	},
	
	"Bostan Mori": {
		"prefix": "bostanmori",
		"body": [
			"/* ACL版：NTT可能なmodintで使用する */",
			"#include<atcoder/convolution>",
			"using namespace atcoder;",
			"template <class T>",
			"vector<T> multiply(const vector<T>& a, const vector<T>& b) {",
			"\treturn atcoder::convolution(a, b);",
			"}",
			"",
			"// /* 愚直版：ACLの畳み込みが使えない型で使用する */",
			"// template <class T>",
			"// vector<T> multiply(const vector<T>& a, const vector<T>& b) {",
			"// \tif (a.empty() || b.empty()) return {};",
			"// \tvector<T> c(a.size() + b.size() - 1);",
			"// \tfor (size_t i = 0; i < a.size(); ++i) {",
			"// \t\tfor (size_t j = 0; j < b.size(); ++j) {",
			"// \t\t\tc[i + j] += a[i] * b[j];",
			"// \t\t}",
			"// \t}",
			"// \treturn c;",
			"// }",
			"",
			"/**",
			" * 母関数A(x) = P(x) / Q(x) の x^n の係数を返す",
			" * 計算量 O(M(d) log n)",
			" * d := deg(Q)",
			" * M(d) := 次数 d の多項式同士の畳み込みにかかる計算量",
			" */",
			"template <class T>",
			"T bostan_mori(",
			"\tvector<T> p, vector<T> q,",
			"\tunsigned long long n",
			") {",
			"\tassert(!q.empty() && q[0] != T{});",
			"",
			"\twhile (!p.empty() && p.back() == T{}) p.pop_back();",
			"\tassert(p.size() < q.size());",
			"",
			"\tconst size_t d = q.size();",
			"\tp.resize(d - 1);",
			"",
			"\twhile (n != 0) {",
			"\t\tvector<T> q_neg = q;",
			"\t\tfor (size_t i = 1; i < q_neg.size(); i += 2) {",
			"\t\t\tq_neg[i] = -q_neg[i];",
			"\t\t}",
			"",
			"\t\tauto pq = multiply(p, q_neg);",
			"\t\tauto qq = multiply(q, q_neg);",
			"",
			"\t\tvector<T> next_p(d - 1);",
			"\t\tvector<T> next_q(d);",
			"\t\tconst size_t parity = static_cast<size_t>(n & 1ULL);",
			"\t\tfor (size_t i = 0; i < next_p.size(); ++i) {",
			"\t\t\tif (2 * i + parity < pq.size()) next_p[i] = pq[2 * i + parity];",
			"\t\t}",
			"\t\tfor (size_t i = 0; i < next_q.size(); ++i) {",
			"\t\t\tif (2 * i < qq.size()) next_q[i] = qq[2 * i];",
			"\t\t}",
			"",
			"\t\tp = move(next_p);",
			"\t\tq = move(next_q);",
			"\t\tn >>= 1;",
			"\t}",
			"",
			"\treturn p.empty() ? T{} : p[0] / q[0];",
			"}",
			"",
			"\tvector<mint>P; // 分子",
			"\tvector<mint>Q; // 分母",
			"\tbostan_mori(P,Q,N);",
		],
	},
	"popcount = k": {
		"prefix": "popcount_k",
		"body": [
			"// https://atcoder.jp/contests/abc406/submissions/65880289",
			"// n以下のpopcountがkの個数を返す",
			"map<pair<ll,ll>, ll> memc;",
			"ll popc(ll n, ll k)",
			"{",
			"  if (k == 0)",
			"    return 1;",
			"  if (n == 0)",
			"    return 0;",
			"  if (memc.contains({n, k}))",
			"    return memc[{n, k}];",
			"  return memc[{n, k}] = popc(n / 2, k) + popc((n - 1) / 2, k - 1);",
			"}",
		],
		"description": "Your description.",
	},
}
