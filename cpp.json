	"区間をsetで管理するやつ": {
		"prefix": [
			"interval_set",
			"kukanwosetdekanrisuruyatu"
		],
		"body": [
			"/**",
			" * [l, r] を set で管理する",
			" * true: 隣接区間をマージする",
			" * false: 隣接区間をマージしない",
			" */",
			"class interval_set {",
			"\tpublic:",
			"\tusing interval = pair<ll, ll>;",
			"\tstruct insert_result {",
			"\t\tll added; // 新しく追加された整数の個数",
			"\t\tvector<interval> erased; // 結合のため set から消去した区間の一覧",
			"\t\tinterval inserted; // 最終的に追加された区間",
			"\t};",
			"",
			"\tprivate:",
			"\tset<interval> st;",
			"\tbool merge_adjacent;",
			"public:",
			"\texplicit interval_set(bool should_merge_adjacent = true)",
			"\t\t: merge_adjacent(should_merge_adjacent) {}",
			"",
			"\t/**",
			"\t * x を含む区間を返す",
			"\t * 見つからない場合は {INT64_MIN, INT64_MIN} を返す",
			"\t */",
			"\tinterval find(ll x) const {",
			"\t\tauto it = st.upper_bound({x, numeric_limits<ll>::max()});",
			"\t\tif (it == st.begin()) return {INT64_MIN, INT64_MIN};",
			"",
			"\t\t--it;",
			"\t\tif (it->second < x) return {INT64_MIN, INT64_MIN};",
			"\t\treturn *it;",
			"\t}",
			"",
			"\t/** ",
			"\t * [l, r] を追加",
			"\t * added := 新しく追加された整数の個数",
			"\t * erased := 結合のため set から消去した区間の一覧",
			"\t * inserted := 最終的に追加された区間",
			"\t */",
			"\tinsert_result insert(ll l, ll r) {",
			"\t\tinsert_result result{0, {}, {INT64_MIN, INT64_MIN}};",
			"\t\tif (l > r) return result;",
			"",
			"\t\tresult.added = r - l + 1;",
			"\t\tauto it = st.lower_bound({l, numeric_limits<ll>::min()});",
			"",
			"\t\tif (it != st.begin()) {",
			"\t\t\tauto prev = prev(it);",
			"\t\t\tif (prev->second >= l ||",
			"\t\t\t\t(merge_adjacent && l != numeric_limits<ll>::min() &&",
			"\t\t\t\t prev->second == l - 1)) it = prev;",
			"\t\t}",
			"",
			"\t\twhile (it != st.end()) {",
			"\t\t\tif (it->first > r &&",
			"\t\t\t\t(!merge_adjacent || r == numeric_limits<ll>::max() ||",
			"\t\t\t\t it->first != r + 1)) break;",
			"",
			"\t\t\tconst auto [a, b] = *it;",
			"\t\t\tconst ll overlap_l = max(l, a);",
			"\t\t\tconst ll overlap_r = min(r, b);",
			"\t\t\tif (overlap_l <= overlap_r) {",
			"\t\t\t\tresult.added -= overlap_r - overlap_l + 1;",
			"\t\t\t}",
			"",
			"\t\t\tl = min(l, a);",
			"\t\t\tr = max(r, b);",
			"\t\t\tresult.erased.push_back(*it);",
			"\t\t\tit = st.erase(it);",
			"\t\t}",
			"",
			"\t\tst.insert({l, r});",
			"\t\tresult.inserted = interval{l, r};",
			"\t\treturn result;",
			"\t}",
			"};",
		],
	},

